# Contact form delivery through Microsoft 365 (Microsoft Graph).
# From the app registration in the Microsoft Entra admin center:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The Microsoft 365 mailbox the enquiries are sent from.
MAIL_SENDER=website@sarasinpicquart.com
# Without these values, /api/contact returns 503 and the form offers a pre-filled mailto: link.
