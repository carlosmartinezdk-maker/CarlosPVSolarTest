# Contact form delivery through Google Workspace.
# The mailbox that sends the enquiries (a user on the sarasinpicquart.com domain).
GMAIL_USER=website@sarasinpicquart.com
# A 16-character app password created for that mailbox (Google Account → Security → App passwords).
# Without these two values, /api/contact returns 503 and the form offers a pre-filled mailto: link.
GMAIL_APP_PASSWORD=
